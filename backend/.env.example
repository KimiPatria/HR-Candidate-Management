# ---- App ----
APP_ENV=dev
HR_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
# Tunnel URL RTC uses to reach this backend (/llm and /rtc/callback)
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Frontend origin candidates open their join link on
CANDIDATE_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# SQLite default; swap to postgresql+asyncpg://user:pass@localhost/ai_interviewer
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---- Mock switch ----
# true = all AI providers return canned responses; no network calls, no credentials needed.
MOCK_AI=true

# ---- Voice pipeline ----
# local = we drive Seed ASR + Seed TTS ourselves (modern single API key). No RTC
#         credentials, no public tunnel needed.
# rtc   = BytePlus RTC's managed agent owns transport/ASR/TTS and calls our
#         /v1/chat/completions. Needs the legacy Seed Speech App ID + Access Token pair.
VOICE_MODE=local

# ---- BytePlus common ----
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
BYTEPLUS_REGION=ap-southeast-1

# ---- RTC (Conversational AI + Flash Avatar) ----
RTC_APP_ID=
RTC_APP_KEY=
RTC_OPENAPI_BASE=https://rtc.ap-southeast-1.byteplusapi.com
# Your account's RTC app is provisioned for the Akool third-party avatar
# integration (confirmed via a live StartVoiceChat call), not native BytePlus avatar.
# "dvp_Tristan_cloth2_1080P" is a real confirmed Akool preset ("Tristan") - no
# training/recording needed. AKOOL_API_KEY comes from Akool (akool.com), not BytePlus -
# ask whoever set up this RTC app's avatar entitlement how that key was provisioned.
AVATAR_ID=dvp_Tristan_cloth2_1080P
AKOOL_API_KEY=

# ---- Dreamina OmniHuman (opening-greeting clip) ----
# A different shape from the avatar above: an async batch job (photo + audio -> mp4),
# billed per second of generated video. Used for ONE clip per interview - the opening
# greeting, generated at setup and replayed to every candidate - never per turn, where
# the per-second pricing would cost ~100x what an interview costs today.
# Leave blank to skip clip generation entirely; interviews then run voice-only.
# Get the req_key from the BytePlus console, and confirm it with
#   .venv/Scripts/python.exe scripts/probe_omnihuman.py <image_url> <audio_url>
OMNIHUMAN_REQ_KEY=
OMNIHUMAN_POLL_TIMEOUT_SECONDS=900

# ---- ModelArk (LLM) ----
MODELARK_API_KEY=
MODELARK_ENDPOINT_ID=
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# ---- Speech (Seed Speech) ----
# Stock voice name, not a credential - pick any *_uranus_bigtts value from the Seed
# TTS 2.0 list (see README).
TTS_VOICE_ID=en_male_tim_uranus_bigtts
# Modern single key (console.byteplus.com/voice/new/overview - "New Console"). Only
# VOICE_MODE=local reads this.
SEED_SPEECH_API_KEY=
# Legacy App ID + Access Token + Secret Key (console.byteplus.com/voice/app - "Old
# Console" -> Create Application -> Trial/Official Use). Only VOICE_MODE=rtc reads
# these; APP_ID/ACCESS_TOKEN feed StartVoiceChat's ASRConfig/TTSConfig, SECRET_KEY is
# captured but currently unused by any call.
SEED_SPEECH_APP_ID=
SEED_SPEECH_ACCESS_TOKEN=
SEED_SPEECH_SECRET_KEY=

# ---- BytePlus Translate ----
# Reuses BYTEPLUS_ACCESS_KEY/SECRET_KEY above. Note the region differs from
# BYTEPLUS_REGION: Translate lives at ap-singapore-1, RTC at ap-southeast-1, and the
# wrong one fails the signature outright rather than degrading.
TRANSLATE_OPENAPI_BASE=https://open.byteplusapi.com
TRANSLATE_REGION=ap-singapore-1
TRANSLATE_API_VERSION=2020-06-01
# Normalise reference documents into this language before embedding them. Blank = index
# each document exactly as uploaded. Set to "en" for a bilingual EN/ID deployment: the
# embedding model is English-tuned, so Indonesian documents otherwise retrieve poorly.
# Existing documents pick this up on reindex, not automatically.
TRANSLATE_INDEX_LANGUAGE=

# ---- Retrieval + memory ----
VDB_KB_API_KEY=
VDB_KB_BASE_URL=https://api-knowledgebase.mlp.ap-mya.byteplus.com
VIKINGDB_MEMORY_API_KEY=
VIKINGDB_MEMORY_BASE_URL=https://api-vikingdb.mlp.ap-mya.byteplus.com

# ---- Drive pickers (optional) ----
# Lets HR pick a job description straight out of Google Drive or OneDrive instead of
# downloading it first. Leave a client id blank and that drive is hidden in the UI; the
# paste and upload paths are unaffected, so this is purely additive.
#
# Every value here is a PUBLIC client identifier and is served to the HR browser by
# /api/integrations. There is deliberately no OAuth client secret: the picker runs in the
# browser, the user consents with their own account, and the resulting access token never
# reaches this backend - only the bytes of the file they picked do.
#
# Google (console.cloud.google.com): enable the Google Picker API and the Google Drive
# API, create an OAuth 2.0 Client ID of type "Web application" with this app's origin as
# an authorised JavaScript origin, and create an API key restricted to the Picker API.
# GOOGLE_APP_ID is the project NUMBER, not the project id.
# The app asks for the drive.file scope (per-file access to what the user picks), which
# is non-sensitive - so no restricted-scope verification, and no security assessment.
GOOGLE_CLIENT_ID=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
# Microsoft (entra.microsoft.com -> App registrations): register an app, add a redirect
# URI of platform type *Web* (not SPA - the v7.2 picker is not an MSAL client) for this
# app's origin, and create a client secret. The secret is never sent anywhere and this
# app does not read it; the v7.2 picker simply requires one to exist on the registration.
MICROSOFT_CLIENT_ID=

# ---- Storage ----
UPLOAD_DIR=./data/uploads
