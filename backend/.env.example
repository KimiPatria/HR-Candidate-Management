# ---- App ----
APP_ENV=dev
HR_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
# Tunnel URL RTC uses to reach this backend (/llm and /rtc/callback)
PUBLIC_BASE_URL=https://your-tunnel.example.com
# Frontend origin candidates open their join link on
CANDIDATE_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# SQLite default; swap to postgresql+asyncpg://user:pass@localhost/ai_interviewer
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---- Mock switch ----
# true = all AI providers return canned responses; no network calls, no credentials needed.
MOCK_AI=true

# ---- BytePlus common ----
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
BYTEPLUS_REGION=ap-southeast-1

# ---- RTC (Conversational AI + Flash Avatar) ----
RTC_APP_ID=
RTC_APP_KEY=
RTC_OPENAPI_BASE=https://rtc.ap-southeast-1.byteplusapi.com
# Your account's RTC app is provisioned for the Akool third-party avatar
# integration (confirmed via a live StartVoiceChat call), not native BytePlus avatar.
# "dvp_Tristan_cloth2_1080P" is a real confirmed Akool preset ("Tristan") - no
# training/recording needed. AKOOL_API_KEY comes from Akool (akool.com), not BytePlus -
# ask whoever set up this RTC app's avatar entitlement how that key was provisioned.
AVATAR_ID=dvp_Tristan_cloth2_1080P
AKOOL_API_KEY=

# ---- ModelArk (LLM) ----
MODELARK_API_KEY=
MODELARK_ENDPOINT_ID=
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# ---- Speech (Seed Speech: one App ID / Access Token covers ASR + TTS) ----
# Stock voice name, not a credential - pick any *_uranus_bigtts value from the Seed
# TTS 2.0 list (see README).
TTS_VOICE_ID=en_male_tim_uranus_bigtts
SEED_SPEECH_APP_ID=
SEED_SPEECH_API_KEY=

# ---- Retrieval + memory ----
VDB_KB_API_KEY=
VDB_KB_BASE_URL=https://api-knowledgebase.mlp.ap-mya.byteplus.com
VIKINGDB_MEMORY_API_KEY=
VIKINGDB_MEMORY_BASE_URL=https://api-vikingdb.mlp.ap-mya.byteplus.com

# ---- Storage ----
UPLOAD_DIR=./data/uploads
