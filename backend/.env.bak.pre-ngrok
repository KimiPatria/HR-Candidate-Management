AVATAR_ID=dvp_Tristan_cloth2_1080P
# STILL MISSING - this comes from Akool (akool.com), not the BytePlus console. Ask
# whoever set up this RTC app's avatar entitlement how the Akool key was provisioned.
AKOOL_API_KEY=

# ---- ModelArk (LLM) ----
MODELARK_API_KEY=ark-04e99d75-d01c-402b-9c57-ae7e237d4222-e89c9
# STILL MISSING - required. Create a model deployment at
# https://console.byteplus.com/ark/region:ark+ap-southeast-1/endpoint and paste its
# endpoint id (looks like "ep-xxxxxxxx-xxxxx") here - this is not the same as the API key.
MODELARK_ENDPOINT_ID=ep-20260828155959-sg6q6
MODELARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# ---- Speech (Seed Speech) ----
# Stock voice preset - "Tim", a Seed TTS 2.0 English male voice. No account lookup
# needed, this is a fixed name from BytePlus's voice list, not a credential. Swap for
# any other *_uranus_bigtts voice (e.g. en_female_stokie_uranus_bigtts) if you prefer.
TTS_VOICE_ID=en_male_tim_uranus_bigtts

# Modern single key (console.byteplus.com/voice/new/overview - "New Console"), sent as
# the X-Api-Key header. Only VOICE_MODE=local reads this.
#
# CONFIRMED WORKING for VOICE_MODE=local: a live scripts/probe_speech.py run synthesised
# a sentence through Seed TTS 2.0 and recognised it back through Seed ASR 2.0 using this
# key alone. `app/services/speech_check.py` re-checks it against both gateways at startup.
SEED_SPEECH_API_KEY=7a4c011e-9a40-4df1-bd3c-d55b5db8ff13

# Legacy App ID + Access Token + Secret Key, from console.byteplus.com/voice/app
# ("Old Console") -> Create Application -> Trial/Official Use. Only VOICE_MODE=rtc reads
# these - StartVoiceChat's ASRConfig wants AppId/AccessToken, TTSConfig wants
# app.appid/app.token, and the official byteplus-sdk/RTC_AIGC_Demo reference confirms no
# ApiKey field exists for the BytePlus provider, so the modern key above cannot be handed
# to the RTC agent at all. SEED_SPEECH_SECRET_KEY is captured but currently unread by any
# call - the RTC demo reference never uses it, only App ID + Access Token.
SEED_SPEECH_APP_ID=9861788701
SEED_SPEECH_ACCESS_TOKEN=CIlOm17-nqpljRqhMo7OGr3w2VHdAhf8
SEED_SPEECH_SECRET_KEY=ayvTjdtq6yEW343I0PqzY7PXSnM857tt

