# ---- App ----
APP_ENV=dev
HR_PASSWORD=Wcs@2026
SESSION_SECRET=change-me-to-a-long-random-string
# Tunnel URL RTC uses to reach this backend (/llm and /rtc/callback).
# ONLY needed when VOICE_MODE=rtc. Local mode makes outbound connections only, so no
# tunnel has to be running and this value is ignored.
PUBLIC_BASE_URL=https://later-indie-forth-perfect.trycloudflare.com
# Frontend origin candidates open their join link on
CANDIDATE_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
# SQLite default; swap to postgresql+asyncpg://user:pass@localhost/ai_interviewer
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ---- Mock switch ----
# true = all AI providers return canned responses; no network calls, no credentials needed.
MOCK_AI=false

# ---- Voice pipeline ----
# local = we drive Seed ASR + Seed TTS ourselves over WebSocket with the modern single
#         API key (SEED_SPEECH_API_KEY below), and run the turn loop in-process. Needs
#         NO RTC credentials and NO public tunnel - nothing calls back in.
# rtc   = BytePlus RTC's managed agent (StartVoiceChat) owns transport/ASR/TTS and calls
#         our /v1/chat/completions. Requires the LEGACY Seed Speech App ID + Access Token
#         pair, which the upgraded Speech console no longer issues - see SEED_SPEECH_*.
# Both modes share the same interview logic (app/services/interview_turn.py), so this is
# a transport switch only.
#
# On rtc, PUBLIC_BASE_URL must be a tunnel that is LIVE RIGHT NOW and pointing at this
# backend - RTC fetches every candidate reply over it. A `cloudflared tunnel --url` quick
# tunnel mints a new random hostname on every start, so a stale one leaves the interview
# deaf: the greeting plays (we generate that locally) and the candidate is then never
# heard, with no error anywhere. That is what happened on 2026-09-02. The backend now
# verifies the URL really reaches it before starting an agent, so this fails loudly
# instead - but local mode avoids the whole dependency, which is why it is the default.
VOICE_MODE=local

# ---- BytePlus common ----
BYTEPLUS_ACCESS_KEY=AKAPNDk2ZTYwOTdmOTY2NDBlYjhmMGE1MWJjNjkxZDRkNjU
BYTEPLUS_SECRET_KEY=TkRkbVpERmtZV1kxTldZME5EY3lNamxqWWpsa1ptVTVZVEEzTVdNMllUUQ==
BYTEPLUS_REGION=ap-southeast-1

# ---- RTC (Conversational AI + Flash Avatar) ----
RTC_APP_ID=6a912b142715db016a953189
RTC_APP_KEY=698df091459443d2bc0dc8c3593407f1
RTC_OPENAPI_BASE=https://rtc.ap-southeast-1.byteplusapi.com
# CONFIRMED LIVE: your account's RTC app is provisioned for the Akool third-party
# avatar integration, not native BytePlus avatar (a real StartVoiceChat call proved
# this). "dvp_Tristan_cloth2_1080P" is a real confirmed Akool preset ("Tristan") -
